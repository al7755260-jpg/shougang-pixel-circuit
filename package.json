{
  "name": "shougang-pixel-circuit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node server.mjs",
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/compress-assets.mjs",
    "build:public": "node scripts/prepare-assets.mjs && vite build --mode public && node scripts/package-public.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.1.0",
    "fflate": "0.8.3",
    "three": "0.185.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "vite": "7.3.1"
  }
}
